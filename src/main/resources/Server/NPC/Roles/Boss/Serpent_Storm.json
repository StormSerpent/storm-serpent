{
  "Type": "Generic",
  "StartState": "Idle",
  "Appearance": "Serpent_Storm_Head",
  "NameTranslationKey": "server.npcRoles.Serpent_Storm",
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Neutral",
  "MaxHealth": 2000,
  "BreathesInAir": true,
  "BreathesInWater": true,
  "IsMemory": true,
  "MemoriesCategory": "Mythic",
  "SpawnLockTime": 0,
  "Parameters": {
    "StalkForgetTimeout": {
      "Value": [ 12, 16 ],
      "Description": "How long to wait before switching from Stalk to Idle when no targets are visible"
    },
    "IntroBuildupShootInterval": {
      "Value": [ 2, 4 ],
      "Description": "Interval between shooting during the Intro Buildup state"
    },
    "IntroBuildupDuration": {
      "Value": [ 12, 12 ],
      "Description": "How long to stay in the Intro Buildup state before switching to Intro Transition"
    },
    "IntroTransitionDuration": {
      "Value": [ 16, 20 ],
      "Description": "How long to stay in the Intro Transition state before switching to Combat Attack"
    }
  },
  "MotionControllerList": [
    {
      "Type": "StormSerpentFly",
      "MaxHorizontalSpeed": 45,
      "MaxClimbSpeed": 25.0,
      "MaxSinkSpeed": 75.0,
      "SpeedChangeDuration": 1.0,
      "DirectionChangeDuration": 1.0,
      "EpsilonSpeed": 0.01
    }
  ],
  "Instructions": [
    {
      "Continue": true,
      "Sensor": {
        "Type": "Flag",
        "Name": "Initialized",
        "Set": false
      },
      "Actions": [
        {
          "Type": "StormSerpentInitialize",
          "SerpentConfig": "Serpent_Storm"
        },
        {
          "Type": "SetLeashPosition",
          "ToCurrent": true
        },
        {
          "Type": "SetFlag",
          "Name": "Initialized",
          "SetTo": true
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "StormSerpentReadLeashPosition"
          },
          "BodyMotion": {
            "Type": "StormSerpentWander",
            "Radius": 200,
            "AltitudeRange": [ 100, 320 ],
            "UseRelativeAltitude": false,
            "RelativeSpeed": 0.75
          }
        },
        {
          "Continue": true,
          "HeadMotion": { "Type": "StormSerpentMatchBodyMotion" }
        },
        {
          "Sensor": {
            "Type": "Damage",
            "Combat": true
          },
          "Actions": [
            { "Type": "AddToHostileTargetMemory" },
            {
              "Type": "State",
              "State": "Intro"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Player",
            "Range": 175,
            "LockOnTarget": true,
            "LockedTargetSlot": "Stalk_Target",
            "Filters": [
              { "Type": "LineOfSight" },
              {
                "Type": "ViewSector",
                "ViewSector": 180
              },
              {
                "Type": "Not",
                "Filter": {
                  "Type": "MovementState",
                  "State": "Crouching"
                }
              }
            ]
          },
          "Actions": [
            {
              "Type": "StorePosition",
              "Slot": "Stalk_Target_Last_Seen"
            },
            {
              "Type": "State",
              "State": "Stalk"
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Stalk"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "ReadPosition",
            "Slot": "Stalk_Target_Last_Seen",
            "Range": 1000
          },
          "BodyMotion": {
            "Type": "StormSerpentWander",
            "Radius": 150,
            "AltitudeRange": [ 16, 80 ],
            "UseRelativeAltitude": true,
            "RelativeSpeed": 1.25
          },
          "HeadMotion": { "Type": "StormSerpentMatchBodyMotion" },
          "Actions": [
            {
              "Type": "TimerStart",
              "Name": "Stalk_Forget",
              "Repeating": false,
              "StartValueRange": { "Compute": "StalkForgetTimeout" },
              "RestartValueRange": { "Compute": "StalkForgetTimeout" }
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Damage",
            "Combat": true
          },
          "Actions": [
            { "Type": "AddToHostileTargetMemory" },
            {
              "Type": "State",
              "State": "Intro"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Player",
            "Range": 175,
            "OnlyLockedTarget": true,
            "LockedTargetSlot": "Stalk_Target",
            "Filters": [ { "Type": "LineOfSight" } ]
          },
          "Actions": [
            {
              "Type": "StorePosition",
              "Slot": "Stalk_Target_Last_Seen"
            },
            {
              "Type": "TimerRestart",
              "Name": "Stalk_Forget"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Timer",
            "Name": "Stalk_Forget",
            "State": "Stopped"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Idle"
            }
          ]
        }
      ]
    },
    {
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "Intro.Default"
      },
      "Actions": [
        { "Type": "StormSerpentBeginFight" },
        {
          "Type": "PlayAnimation",
          "Animation": "Shriek_Engaged",
          "Slot": "Status"
        },
        {
          "Type": "State",
          "State": "Intro.Buildup"
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Intro.Buildup"
      },
      "Instructions": [
        {
          "Continue": true,
          "Actions": [
            {
              "Type": "TimerStart",
              "Name": "Intro_Buildup_Shoot",
              "Repeating": false,
              "StartValueRange": { "Compute": "IntroBuildupShootInterval" },
              "RestartValueRange": { "Compute": "IntroBuildupShootInterval" }
            },
            {
              "Type": "TimerStart",
              "Name": "Intro_Buildup_Transition",
              "Repeating": false,
              "StartValueRange": { "Compute": "IntroBuildupDuration" },
              "RestartValueRange": { "Compute": "IntroBuildupDuration" }
            }
          ]
        },
        {
          "Continue": true,
          "Sensor": {
            "Type": "ReadPosition",
            "Slot": "Stalk_Target_Last_Seen",
            "Range": 1000
          },
          "BodyMotion": {
            "Type": "StormSerpentWander",
            "Radius": 100,
            "AltitudeRange": [ 25, 100 ],
            "UseRelativeAltitude": true,
            "RelativeSpeed": 2.0
          }
        },
        {
          "Sensor": {
            "Type": "Timer",
            "Name": "Intro_Buildup_Transition",
            "State": "Stopped"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Intro.Transition"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "And",
            "Sensors": [
              {
                "Type": "Timer",
                "Name": "Intro_Buildup_Shoot",
                "State": "Stopped"
              },
              {
                "Type": "Target",
                "TargetSlot": "Stalk_Target",
                "Range": 200,
                "Filters": [ { "Type": "LineOfSight" } ]
              }
            ]
          },
          "HeadMotion": { "Type": "Watch" },
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "Attack",
              "Attack": "Root_NPC_Serpent_Storm_Attack",
              "AttackType": "Ability1"
            },
            {
              "Type": "Timeout",
              "Delay": [ 4.75, 4.75 ]
            },
            {
              "Type": "TimerRestart",
              "Name": "Intro_Buildup_Shoot"
            }
          ]
        },
        {
          "HeadMotion": { "Type": "StormSerpentMatchBodyMotion" }
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Intro.Transition"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "Player",
            "Range": 500
          },
          "BodyMotion": {
            "$Comment": "Encircle the player with an oscillating radius of 16..70 meters",
            "Type": "StormSerpentEncircle",
            "RelativeSpeed": 1.0,
            "RelativeAltitude": 30,
            "OscillateRadiusAmplitude": 27,
            "OscillateRadiusFrequency": 0.5,
            "OscillateYAmplitude": 16,
            "OscillateYFrequency": 1,
            "Radius": 43
          },
          "HeadMotion": { "Type": "StormSerpentMatchBodyMotion" }
        },
        {
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": { "Compute": "IntroTransitionDuration" }
            },
            {
              "Type": "State",
              "State": "Combat.Attack"
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Combat.Attack"
      },
      "Actions": [
        {
          "Once": true,
          "Type": "Log",
          "Message": "Combat.Attack"
        }
      ],
      "BodyMotion": {
        "Type": "StormSerpentDive",
        "RelativeSpeed": 2.0
      },
      "HeadMotion": {
        "Type": "StormSerpentMatchBodyMotion"
      }
    }
  ]
}
