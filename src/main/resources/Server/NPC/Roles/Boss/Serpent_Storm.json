{
  "Type": "Generic",
  "StartState": "Idle",
  "Appearance": "Serpent_Storm_Head",
  "NameTranslationKey": "server.npcRoles.Serpent_Storm",
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Neutral",
  "MaxHealth": 2000,
  "BreathesInAir": true,
  "BreathesInWater": true,
  "IsMemory": true,
  "MemoriesCategory": "Mythic",
  "SpawnLockTime": 0,
  "Parameters": {
    "StalkForgetTimeout": {
      "Value": [ 12, 16 ],
      "Description": "How long to wait before switching from Stalk to Idle when no targets are visible"
    },
    "IntroBuildupShootInterval": {
      "Value": [ 1.25, 2.25 ],
      "Description": "Interval between shooting during the Intro Buildup state"
    },
    "IntroBuildupDuration": {
      "Value": [ 16, 18 ],
      "Description": "How long to stay in the Intro Buildup state before switching to Intro Transition"
    },
    "IntroTransitionDuration": {
      "Value": [ 16, 20 ],
      "Description": "How long to stay in the Intro Transition state before switching to Combat"
    },
    "IdleRelativeSpeed": {
      "Value": 0.75,
      "Description": "Relative movement speed in the Idle state"
    },
    "StalkRelativeSpeed": {
      "Value": 0.85,
      "Description": "Relative movement speed in the Stalk state"
    },
    "IntroBuildupRelativeSpeed": {
      "Value": 1.0,
      "Description": "Relative movement speed in the Intro Buildup state"
    },
    "IntroBuildupShootRelativeSpeed": {
      "Value": 0.1,
      "Description": "Relative movement speed while shooting projectiles in the Intro Buildup state"
    }
  },
  "MotionControllerList": [
    {
      "Type": "StormSerpentFly",
      "MaxHorizontalSpeed": 45,
      "MaxClimbSpeed": 25.0,
      "MaxSinkSpeed": 75.0,
      "SpeedChangeDuration": 1.0,
      "DirectionChangeDuration": 1.0,
      "HeadTurnDuration": 5.0,
      "EpsilonSpeed": 0.01
    }
  ],
  "DeathInstruction": {
    "Actions": [
      {
        "Once": true,
        "Type": "PlaySound",
        "SoundEventId": "SFX_Serpent_Storm_Shriek"
      }
    ]
  },
  "Instructions": [
    {
      "Continue": true,
      "Sensor": {
        "Type": "Flag",
        "Name": "Initialized",
        "Set": false
      },
      "Actions": [
        {
          "Type": "StormSerpentInitialize",
          "SerpentConfig": "Serpent_Storm"
        },
        {
          "Type": "SetLeashPosition",
          "ToCurrent": true
        },
        {
          "Type": "SetFlag",
          "Name": "Initialized",
          "SetTo": true
        }
      ]
    },
    {
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": { "Type": "StormSerpentReadLeashPosition" },
          "BodyMotion": {
            "Type": "StormSerpentWander",
            "Radius": 200,
            "AltitudeRange": [ 100, 320 ],
            "UseRelativeAltitude": false,
            "RelativeSpeed": { "Compute": "IdleRelativeSpeed" }
          }
        },
        {
          "Continue": true,
          "HeadMotion": { "Type": "StormSerpentMatchBodyMotion" }
        },
        {
          "Sensor": {
            "Type": "Damage",
            "Combat": true,
            "TargetSlot": "Target_Combat_First_Attacker"
          },
          "Actions": [
            { "Type": "AddToHostileTargetMemory" },
            {
              "Type": "State",
              "State": "Intro.Default"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Player",
            "Range": 175,
            "LockOnTarget": true,
            "LockedTargetSlot": "Target_Stalk",
            "Filters": [
              { "Type": "LineOfSight" },
              {
                "Type": "ViewSector",
                "ViewSector": 180
              },
              {
                "Type": "Not",
                "Filter": {
                  "Type": "MovementState",
                  "State": "Crouching"
                }
              }
            ]
          },
          "Actions": [
            {
              "Type": "StorePosition",
              "Slot": "Target_Stalk_Last_Seen"
            },
            {
              "Type": "State",
              "State": "Stalk.Default"
            }
          ]
        }
      ]
    },
    {
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "Stalk"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "ReadPosition",
            "Slot": "Target_Stalk_Last_Seen",
            "Range": 400
          },
          "BodyMotion": {
            "Type": "StormSerpentWander",
            "Radius": 150,
            "AltitudeRange": [ 16, 80 ],
            "UseRelativeAltitude": true,
            "RelativeSpeed": { "Compute": "StalkRelativeSpeed" }
          },
          "HeadMotion": { "Type": "StormSerpentMatchBodyMotion" },
          "Actions": [
            {
              "Type": "TimerStart",
              "Name": "Timer_Stalk_Forget",
              "Repeating": false,
              "StartValueRange": { "Compute": "StalkForgetTimeout" },
              "RestartValueRange": { "Compute": "StalkForgetTimeout" }
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Damage",
            "Combat": true,
            "TargetSlot": "Target_Combat_First_Attacker"
          },
          "Actions": [
            { "Type": "AddToHostileTargetMemory" },
            {
              "Type": "State",
              "State": "Intro"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Player",
            "Range": 175,
            "OnlyLockedTarget": true,
            "LockedTargetSlot": "Target_Stalk",
            "Filters": [ { "Type": "LineOfSight" } ]
          },
          "Actions": [
            {
              "Type": "StorePosition",
              "Slot": "Target_Stalk_Last_Seen"
            },
            {
              "Type": "TimerRestart",
              "Name": "Timer_Stalk_Forget"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Timer",
            "Name": "Timer_Stalk_Forget",
            "State": "Stopped"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Idle"
            }
          ]
        }
      ]
    },
    {
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "Intro.Default"
      },
      "Actions": [
        { "Type": "StormSerpentBeginFight" },
        {
          "Type": "PlayAnimation",
          "Animation": "Shriek_Engaged",
          "Slot": "Status"
        },
        {
          "Type": "State",
          "State": "Intro.Buildup"
        }
      ]
    },
    {
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "Intro.Buildup"
      },
      "Instructions": [
        {
          "Continue": true,
          "Actions": [
            {
              "Type": "TimerStart",
              "Name": "Intro_Buildup_Shoot",
              "Repeating": false,
              "StartValueRange": { "Compute": "IntroBuildupShootInterval" },
              "RestartValueRange": { "Compute": "IntroBuildupShootInterval" }
            },
            {
              "Type": "TimerStart",
              "Name": "Intro_Buildup_Transition",
              "Repeating": false,
              "StartValueRange": { "Compute": "IntroBuildupDuration" },
              "RestartValueRange": { "Compute": "IntroBuildupDuration" }
            }
          ]
        },
        {
          "Sensor": {
            "Type": "And",
            "Sensors": [
              {
                "Type": "Timer",
                "Name": "Intro_Buildup_Transition",
                "State": "Stopped"
              },
              {
                "Type": "Timer",
                "Name": "Intro_Buildup_Shoot",
                "State": "Running"
              }
            ]
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Intro.Transition"
            }
          ]
        },
        {
          "$Comment": "Shoot projectiles at hostiles",
          "Sensor": {
            "Type": "AdjustPosition",
            "Offset": [ 0, 8, 0 ],
            "Sensor": {
              "Type": "And",
              "Sensors": [
                {
                  "Type": "Timer",
                  "Name": "Intro_Buildup_Shoot",
                  "State": "Stopped"
                },
                {
                  "Type": "Or",
                  "Sensors": [
                    {
                      "Type": "Target",
                      "TargetSlot": "Target_Combat_First_Attacker",
                      "Range": 300,
                      "Filters": [ { "Type": "LineOfSight" } ]
                    },
                    {
                      "Type": "Target",
                      "TargetSlot": "Target_Combat_Last_Attacker",
                      "Range": 300,
                      "Filters": [ { "Type": "LineOfSight" } ]
                    },
                    {
                      "Type": "Target",
                      "TargetSlot": "Target_Stalk",
                      "Range": 300,
                      "Filters": [ { "Type": "LineOfSight" } ]
                    }
                  ]
                }
              ]
            }
          },
          "HeadMotion": {
            "Type": "Watch",
            "RelativeTurnSpeed": 0.5
          },
          "BodyMotion": {
            "Type": "StormSerpentWander",
            "Radius": 100,
            "AltitudeRange": [ 25, 100 ],
            "UseRelativeAltitude": true,
            "RelativeSpeed": { "Compute": "IntroBuildupShootRelativeSpeed" }
          },
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "Attack",
              "Attack": "Root_NPC_Serpent_Storm_Attack",
              "AttackType": "Ability1"
            },
            {
              "Type": "Timeout",
              "Delay": [ 4.75, 4.75 ]
            },
            {
              "Type": "TimerRestart",
              "Name": "Intro_Buildup_Shoot"
            }
          ]
        },
        {
          "Continue": true,
          "Sensor": {
            "Type": "Or",
            "Sensors": [
              {
                "Type": "Target",
                "TargetSlot": "Target_Combat_First_Attacker",
                "Range": 1000
              },
              {
                "Type": "Target",
                "TargetSlot": "Target_Combat_Last_Attacker",
                "Range": 1000
              },
              {
                "Type": "Target",
                "TargetSlot": "Target_Stalk",
                "Range": 1000
              },
              {
                "Type": "ReadPosition",
                "Slot": "Target_Stalk_Last_Seen",
                "Range": 1000
              },
              { "Type": "StormSerpentReadLeashPosition" }
            ]
          },
          "BodyMotion": {
            "Type": "StormSerpentWander",
            "Radius": 100,
            "AltitudeRange": [ 25, 100 ],
            "UseRelativeAltitude": true,
            "RelativeSpeed": { "Compute": "IntroBuildupRelativeSpeed" }
          }
        },
        { "HeadMotion": { "Type": "StormSerpentMatchBodyMotion" } }
      ]
    },
    {
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "Intro.Transition"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "Or",
            "Sensors": [
              {
                "Type": "Target",
                "TargetSlot": "Target_Combat_First_Attacker",
                "Range": 1000
              },
              {
                "Type": "Target",
                "TargetSlot": "Target_Combat_Last_Attacker",
                "Range": 1000
              },
              {
                "Type": "Target",
                "TargetSlot": "Target_Stalk",
                "Range": 1000
              },
              {
                "Type": "ReadPosition",
                "Slot": "Target_Stalk_Last_Seen",
                "Range": 1000
              },
              { "Type": "StormSerpentReadLeashPosition" }
            ]
          },
          "BodyMotion": {
            "$Comment": "Encircle the player with an oscillating radius of 16..70 meters",
            "Type": "StormSerpentEncircle",
            "RelativeSpeed": 1.0,
            "RelativeAltitude": 30,
            "OscillateRadiusAmplitude": 27,
            "OscillateRadiusFrequency": 0.5,
            "OscillateYAmplitude": 16,
            "OscillateYFrequency": 1,
            "Radius": 43
          },
          "HeadMotion": { "Type": "StormSerpentMatchBodyMotion" }
        },
        {
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": { "Compute": "IntroTransitionDuration" }
            },
            {
              "Type": "State",
              "State": "Combat"
            }
          ]
        }
      ]
    },
    {
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "Combat"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Damage",
            "Combat": true,
            "TargetSlot": "Target_Combat_Last_Attacker"
          }
        }
      ]
    },
    {
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "Combat.Default"
      },
      "Actions": [
        {
          "$TODO": "Cycle through attacks",
          "Type": "State",
          "State": "Combat.Barrage"
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Combat.Ballistic"
      },
      "Instructions": [
        {
          "Reference": "Component_Instruction_Attack_Sequence_Ballistic",
          "Modify": {
            "_ExportStates": [ "Combat.Default" ]
          }
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Combat.Barrage"
      },
      "Instructions": [
        {
          "Reference": "Component_Instruction_Attack_Sequence_Barrage",
          "Modify": {
            "_ExportStates": [ "Combat.Ballistic" ]
          }
        }
      ]
    }
  ]
}
