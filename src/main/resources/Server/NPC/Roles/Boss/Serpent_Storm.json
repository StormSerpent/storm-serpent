{
  "Parameters": {
    "IdleTargetScanRadius": {
      "Value": 175
    },
    "IdleTargetHiddenWhenCrouched": {
      "Description": "Ignore players that are crouching when scanning for targets while idle",
      "Value": true
    }
  },
  "Type": "Generic",
  "Appearance": "Serpent_Storm_Head",
  "NameTranslationKey": "server.npcRoles.Serpent_Storm",
  "StartState": "Setup",
  "SpawnLockTime": 0,
  "MaxHealth": 200,
  "BreathesInAir": true,
  "BreathesInWater": true,
  "DefaultPlayerAttitude": "Hostile",
  "DefaultNPCAttitude": "Ignore",
  "MotionControllerList": [
    {
      "Type": "StormSerpentFly"
    }
  ],
  "Instructions": [
    {
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "Setup"
      },
      "Actions": [
        {
          "Type": "StormSerpentInitialize",
          "SerpentConfig": "Serpent_Storm"
        },
        {
          "Type": "State",
          "State": "Idle"
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      },
      "Instructions": [
        {
          "Reference": "Component_Instruction_Serpent_Storm_Idle",
          "Modify": {
            "_ExportStates": [
              "Stalk",
              "Combat.Engage"
            ],
            "TargetScanRadius": {
              "Compute": "IdleTargetScanRadius"
            },
            "TargetHiddenWhenCrouched": {
              "Compute": "IdleTargetHiddenWhenCrouched"
            }
          }
        }
      ]
    },
    {
      "$TODO": "Give the serpent light attacks in this state to try and engage the player into combat",
      "Sensor": {
        "Type": "State",
        "State": "Stalk"
      },
      "Instructions": [
        {
          "$TODO": "Change this to SerpentWander once it supports a leash point. We want the serpent to wander around the position a player was last spotted at",
          "Continue": true,
          "Sensor": {
            "Type": "Target",
            "TargetSlot": "Target_Stalk"
          },
          "BodyMotion": {
            "Type": "StormSerpentEncircle",
            "RelativeAltitude": 30
          }
        },
        {
          "$Comment": "If a player attacks, enter into combat",
          "Sensor": {
            "Type": "Damage",
            "Combat": true,
            "TargetSlot": "Target_Attacker"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Combat.Engage"
            }
          ]
        }
      ]
    },
    {
      "$TODO": "Implement Combat.Engage state. This is currently just a placeholder",
      "Sensor": {
        "Type": "State",
        "State": "Combat.Engage"
      },
      "BodyMotion": {
        "Type": "StormSerpentWander"
      },
      "Actions": [
        {
          "Type": "Log",
          "Message": "Entering combat!",
          "Once": true
        }
      ]
    }
  ]
}
