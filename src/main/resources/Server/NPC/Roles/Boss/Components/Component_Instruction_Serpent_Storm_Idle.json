{
  "Type": "Component",
  "Class": "Instruction",
  "ResetOnStateChange": false,
  "Parameters": {
    "_ImportStates": [
      "Stalk",
      "Engage"
    ],
    "TargetHiddenWhenCrouched": {
      "Value": true
    },
    "TargetScanRadius": {
      "Value": 175
    }
  },
  "Content": {
    "Instructions": [
      {
        "Continue": true,
        "BodyMotion": {
          "$TODO": "Stay toward the top of the world (around y=250..350). StormSerpentWander needs updated to support setting a desired altitude",
          "Type": "StormSerpentWander"
        },
        "Actions": [
          {
            "$TODO": "Add a parameter for customizing this timer duration",
            "Type": "TimerStart",
            "Name": "Timer_Idle_Spot_Players",
            "StartValueRange": [
              3,
              3
            ],
            "RestartValueRange": [
              3,
              3
            ]
          }
        ]
      },
      {
        "$Comment": "If a player attacks, immediately enter into combat",
        "Sensor": {
          "Type": "Damage",
          "Combat": true,
          "TargetSlot": "Target_Attacker"
        },
        "Actions": [
          {
            "Type": "ParentState",
            "State": "Engage"
          }
        ]
      },
      {
        "$Comment": "If players have been visible for long enough, switch to stalking them",
        "Sensor": {
          "Type": "Timer",
          "Name": "Timer_Idle_Spot_Players",
          "State": "Stopped"
        },
        "Actions": [
          {
            "Type": "ParentState",
            "State": "Stalk"
          }
        ]
      },
      {
        "$Comment": "If no players are visible, restart the timer",
        "Sensor": {
          "Type": "Not",
          "Sensor": {
            "Type": "Player",
            "Range": {
              "Compute": "TargetScanRadius"
            },
            "LockOnTarget": true,
            "LockedTargetSlot": "Target_Stalk",
            "Filters": [
              {
                "Type": "Attitude",
                "Attitudes": [
                  "Hostile"
                ]
              },
              {
                "Type": "LineOfSight"
              },
              {
                "Enabled": {
                  "Compute": "TargetHiddenWhenCrouched"
                },
                "Type": "Not",
                "Filter": {
                  "Type": "MovementState",
                  "State": "Crouching"
                }
              }
            ]
          }
        },
        "Actions": [
          {
            "Type": "TimerRestart",
            "Name": "Timer_Idle_Spot_Players"
          }
        ]
      }
    ]
  }
}
